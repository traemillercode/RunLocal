{
  "name": "run-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Run Local — city-scoped running community (MVP, launch city: Columbia, MO)",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "bun run serve.ts",
    "publish": "bash ./publish.sh",
    "icons": "bun scripts/gen-icons.mjs",
    "server": "bun run serve.ts",
    "retention:purge": "bun scripts/retention-purge.ts",
    "verify:all": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
